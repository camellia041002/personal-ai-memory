{
  "name": "personal-ai-memory-v8",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "vars": {
    "V9_AUTH_MODE": "off",
    "V9_INFRA_ENABLED": "false",
    "V9_RECALL_ENABLED": "false"
  },
  "kv_namespaces": [
    { "binding": "MEMORY" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "personal-ai-memory-v8-db" }
  ],
  "vectorize": [
    { "binding": "VECTORIZE_INDEX", "index_name": "personal-ai-memory-v8-index" }
  ],
  "ai": {
    "binding": "AI"
  }
}
