{
  "name": "personal-ai-memory",
  "version": "8.0.0-public.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:v8-package": "node scripts/build-v8-package.mjs",
    "test": "node --test",
    "check:config": "node scripts/validate-config.mjs --deploy",
    "check:config:lite": "node scripts/validate-config.mjs --provision lite/wrangler.jsonc",
    "check:config:v8": "node scripts/validate-config.mjs --provision v8/wrangler.jsonc",
    "check:config:templates": "node scripts/validate-config.mjs --template wrangler.example.jsonc examples/kv-only/wrangler.example.jsonc examples/vector-search/wrangler.example.jsonc",
    "check": "npm run build:v8-package && npm run test && npm run check:config:lite && npm run check:config:v8 && npm run check:config:templates",
    "seed:sample": "node scripts/seed-sample.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
